# DataHub connection
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
DATAHUB_FRONTEND_URL=http://localhost:9002

# LLM provider (used for incident summarization + resolution drafting)
# Options: openai | anthropic | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Detector thresholds (override defaults in src/dataforge/config.py)
FRESHNESS_SLA_HOURS=24
SCHEMA_DRIFT_SEVERITY=warn
DISTRIBUTION_PSI_THRESHOLD=0.2

# Agent runtime
AGENT_POLL_INTERVAL_SECONDS=300
AGENT_DRY_RUN=false

# Optional: MCP server endpoint (if running datahub-mcp-server instead of REST)
MCP_SERVER_URL=
